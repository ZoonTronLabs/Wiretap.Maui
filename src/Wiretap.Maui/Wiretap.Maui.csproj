<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-ios;net10.0-maccatalyst;net10.0-android</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- iOS/Mac Catalyst -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

    <!-- NuGet Package Metadata -->
    <PackageId>Wiretap.Maui</PackageId>
    <Title>Wiretap.Maui</Title>
    <Description>In-app HTTP traffic inspector for .NET MAUI with quiet notification access, bounded request capture, and optional host-provided SQLite persistence.</Description>
    <Authors>Artyom</Authors>
    <PackageTags>maui;http;inspector;debug;network;wiretap;chucker;traffic;api;rest</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ZoonTronLabs/Wiretap.Maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ZoonTronLabs/Wiretap.Maui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Versioning -->
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>

    <!-- Build settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DefineConstants>$(DefineConstants);MAUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- The host chooses and initializes its SQLite provider. -->
    <PackageReference Include="sqlite-net-base" Version="1.9.172" />
    <!-- PDF export -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>

  <Target Name="RejectStaleAndroidArchive" BeforeTargets="GenerateNuspec">
    <Error
      Condition="Exists('$(MSBuildProjectDirectory)/bin/$(Configuration)/net10.0-android/$(AssemblyName).aar')"
      Text="A stale Android AAR would enter the NuGet package. Remove the generated AAR and pack again." />
  </Target>

</Project>
